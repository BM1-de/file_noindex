{
    "name": "bm1/file-noindex",
    "type": "typo3-cms-extension",
    "version": "1.2.0",
    "description": "Exclude single files/images from search engines (Google Image Search) via a dynamically generated robots.txt - toggled per file in the file list.",
    "keywords": [
        "TYPO3 CMS",
        "Extension",
        "robots.txt",
        "noindex",
        "SEO",
        "FAL",
        "Google Image Search"
    ],
    "homepage": "https://github.com/BM1-de/file_noindex",
    "license": [
        "GPL-2.0-or-later"
    ],
    "support": {
        "issues": "https://github.com/BM1-de/file_noindex/issues",
        "source": "https://github.com/BM1-de/file_noindex",
        "docs": "https://docs.typo3.org/p/bm1/file-noindex/main/en-us/"
    },
    "authors": [
        {
            "name": "Phillip Baumgärtner",
            "role": "Developer",
            "email": "baumgaertner@bm1.de",
            "homepage": "https://bm1.de"
        }
    ],
    "require": {
        "php": ">=8.1",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "typo3/tailor": "^1.6",
        "typo3/testing-framework": "^8.2 || ^9"
    },
    "scripts": {
        "check:cs": "php-cs-fixer fix --dry-run --diff",
        "check:phpstan": "phpstan analyse",
        "fix:cs": "php-cs-fixer fix",
        "test:functional": "phpunit -c Build/phpunit/FunctionalTests.xml",
        "test:unit": "phpunit -c Build/phpunit/UnitTests.xml"
    },
    "replace": {
        "typo3-ter/file-noindex": "*"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "file_noindex",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Bm1\\FileNoindex\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bm1\\FileNoindex\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    }
}
